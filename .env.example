# Supabase — create a project at https://supabase.com, then copy
# Project Settings -> API -> Project URL and anon/public key.
# The app runs without these using local seed data; set them to enable
# auth, persisted carts, orders and the distributor inbox.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — optional. Create a free account at https://www.emailjs.com, add an
# email service and two templates (see README, "Email notifications").
# Without these no mail is sent and everything else keeps working.
# Account -> General -> Public Key
VITE_EMAILJS_PUBLIC_KEY=
# Email Services -> Service ID
VITE_EMAILJS_SERVICE_ID=
# Template ID of "Order confirmation"
VITE_EMAILJS_TEMPLATE_ORDER=
# Template ID of "Inbox notification"
VITE_EMAILJS_TEMPLATE_INBOX=
# Receives inbox mail and order copies. Defaults to site.email when empty.
VITE_STORE_EMAIL=
